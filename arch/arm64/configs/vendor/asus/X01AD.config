# CNSS
CONFIG_CNSS_GENL=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# exFAT
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_CDFINGER_FP=y
CONFIG_FOCAL_FP=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Net
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# NFC
# CONFIG_NFC_NQ is not set

# Platform
CONFIG_MACH_ASUS_X01AD=y

# pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx=y
CONFIG_TOUCHSCREEN_ILI9881H=y

# USB ConfigFS
CONFIG_USB_CONFIGFS_F_UVC=y

# WLAN
CONFIG_PRONTO_WLAN=y
